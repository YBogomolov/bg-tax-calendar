{
  "name": "bg-tax-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static Bulgarian tax and social-insurance calendar built from the official NRA documents.",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "build": "tsx scripts/build.ts",
    "serve": "tsx scripts/serve.ts",
    "dev": "pnpm build && pnpm serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.1.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
